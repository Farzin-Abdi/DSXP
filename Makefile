#---------------------------------------------------------------------------------
# DSXP - an MP3 player for Nintendo DS
#
# Both CPUs are ours. The ARM9 is source/; arm7/ is a custom ARM7 core
# that replaces calico's prebuilt ds7_maine.elf, and it is ON by default
# - see "which ARM7 core" below for what it is for and how to turn it
# off.
#
# This header used to say the opposite: "single-CPU project", "the ARM7
# runs calico's stock core", "arm7/ is currently dormant". None of that
# had been true since the headphone pin was wired up, and it is the kind
# of wrong that costs a day - anybody chasing a sound, power or hinge
# problem would have gone looking on the wrong processor, in a binary
# they had been told was not in the ROM.
#
# Prerequisite: ./tools/build_libmad.sh (once) to produce libs/libmad.
#---------------------------------------------------------------------------------
.SUFFIXES:
#---------------------------------------------------------------------------------

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
endif

include $(DEVKITARM)/ds_rules

# --- which ARM7 core ------------------------------------------------
#
# arm7/ replaces calico's prebuilt ds7_maine.elf. It exists for one thing:
# reading the DSi's headphone-socket pin, which lives in ARM7 I/O space
# and which the ARM9 cannot address.
#
# On by default. It was briefly turned off while hunting a stutter, on the
# theory that a hand-built core might schedule maxmod's mixer worse than
# the stock one - but the stutter survived the revert, so the core was not
# the cause and the feature should not pay for it. (It was settings being
# written to the card every few seconds; see the resume notes in main.c.)
#
# Set DSXP_OWN_ARM7=0 to go back to the stock core. The ARM9 half then
# compiles out entirely, which matters: Jack_Init waits on a PXI channel
# that ds7_maine.elf never opens, so linking it without that guard would
# hang at startup rather than degrade.
DSXP_OWN_ARM7 ?= 1

ifeq ($(DSXP_OWN_ARM7),1)
export DSXP_ARM7 ?= $(CURDIR)/arm7/dsxp7.elf
_ARM7_ELF	:=	-7 $(DSXP_ARM7)
endif

#---------------------------------------------------------------------------------
TARGET		:=	dsxp
BUILD		:=	build
SOURCES		:=	source
INCLUDES	:=	source
DATA		:=

GAME_TITLE	:=	DSXP Media Player
GAME_SUBTITLE1	:=	MP3 player for Nintendo DS
GAME_SUBTITLE2	:=	dsxp homebrew

# 32x32 16-colour BMP, generated by tools/make_icon.py (already committed).
#
# Exported, because the rule that bakes it in runs in a sub-make started
# with -C build, where $(CURDIR) is the build directory: the wildcard
# below then finds nothing, GAME_ICON stays unset, and ds_rules quietly
# substitutes calico's default picture of a DS console. Nothing fails -
# a banner is still written and the ROM still boots - so the only symptom
# was the wrong icon on the menu, which is a thing you have to look at a
# flashcart to see. tools/check_icon.py now looks instead.
ifneq ($(wildcard $(CURDIR)/gfx/icon.bmp),)
export GAME_ICON	:=	$(CURDIR)/gfx/icon.bmp
endif

#---------------------------------------------------------------------------------
# options for code generation
#---------------------------------------------------------------------------------
ARCH		:=	-march=armv5te -mtune=arm946e-s -mthumb

CFLAGS	:=	-g -Wall -Wextra -O2 -ffunction-sections -fdata-sections \
			$(if $(filter 1,$(DSXP_OWN_ARM7)),-DDSXP_OWN_ARM7) \
			-fomit-frame-pointer $(ARCH)
CFLAGS	+=	$(INCLUDE) -DARM9 -DDSXP_COUNT_PIXELS
CXXFLAGS	:=	$(CFLAGS) -fno-rtti -fno-exceptions

ASFLAGS	:=	-g $(ARCH)
LDFLAGS	=	-specs=ds_arm9.specs -g $(ARCH) -Wl,--gc-sections -Wl,-Map,$(notdir $*.map)

#---------------------------------------------------------------------------------
# libmad is not part of devkitPro's portlibs, so it comes out of our own
# libs/ tree (built by tools/build_libmad.sh) rather than $(PORTLIBS).
#---------------------------------------------------------------------------------
LIBS	:=	-lmad -lfat -lmm9 -lnds9 -lm
LIBDIRS	:=	$(CURDIR)/libs/libmad $(LIBNDS)

#---------------------------------------------------------------------------------
ifneq ($(BUILDDIR), $(CURDIR))
#---------------------------------------------------------------------------------

export OUTPUT	:=	$(CURDIR)/$(TARGET)

export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir)) \
					$(foreach dir,$(DATA),$(CURDIR)/$(dir))

export DEPSDIR	:=	$(CURDIR)/$(BUILD)

CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
SFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
BINFILES	:=	$(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.*)))

export LD	:=	$(CC)

export OFILES	:=	$(addsuffix .o,$(BINFILES)) \
					$(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)

export INCLUDE	:=	$(foreach dir,$(INCLUDES),-iquote $(CURDIR)/$(dir)) \
					$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
					-I$(CURDIR)/$(BUILD)

export LIBPATHS	:=	$(foreach dir,$(LIBDIRS),-L$(dir)/lib)

.PHONY: $(BUILD) arm7 clean distclean libmad test

#---------------------------------------------------------------------------------
$(BUILD): libs/libmad/lib/libmad.a $(if $(filter 1,$(DSXP_OWN_ARM7)),arm7)
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) BUILDDIR=`cd $(BUILD) && pwd` --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile

# Kept below $(BUILD) so that it stays the default goal: make picks the
# first target in the file, and putting this above it silently turned
# "make" into "make arm7" - which built the ARM7 and stopped.
arm7:
	@$(MAKE) --no-print-directory -C arm7

#---------------------------------------------------------------------------------
# Fail with an instruction instead of a wall of "mad.h: No such file".
#---------------------------------------------------------------------------------
libs/libmad/lib/libmad.a:
	@echo "libmad has not been built yet - run ./tools/build_libmad.sh first." >&2
	@false

libmad:
	./tools/build_libmad.sh

#---------------------------------------------------------------------------------
# Host-side checks: decoder behaviour, plus BMP renders of every UI screen.
# Builds with the host compiler, needs no DS.
#---------------------------------------------------------------------------------
test:
	./tools/run_tests.sh

#---------------------------------------------------------------------------------
clean:
	@echo clean ...
	@rm -fr $(BUILD) $(TARGET).elf $(TARGET).nds $(TARGET).map $(TARGET).lst
	@rm -fr tools/hosttest/build
	@$(MAKE) --no-print-directory -C arm7 clean

# Also throws away the cross-compiled libmad, so a following build needs
# ./tools/build_libmad.sh again.
distclean: clean
	@rm -fr libs/libmad libs/build

#---------------------------------------------------------------------------------
else

DEPENDS	:=	$(OFILES:.o=.d)

#---------------------------------------------------------------------------------
# The icon is a prerequisite as well as an argument: ndstool reads it at
# link time, but nothing else depends on it, so redrawing it would not
# otherwise rebuild anything.
$(OUTPUT).nds	:	$(OUTPUT).elf $(GAME_ICON)
$(OUTPUT).elf	:	$(OFILES)

-include $(DEPSDIR)/*.d

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
