# Build output. All of it is regenerated by `make`; none of it belongs in
# history, and the ROM is what a release attaches rather than what the
# repository carries.
build/
arm7/build/
arm7/*.elf
arm7/*.map
*.elf
*.map
*.nds

# libmad: fetched and cross-compiled by tools/build_libmad.sh. Several
# megabytes of third-party source that the script can reproduce exactly.
libs/build/
libs/libmad/

# Host-test binaries, synthetic MP3s and the rendered screen previews.
tools/hosttest/build/

.DS_Store

# Music. Test tracks get dropped in here while working on playback, and
# they are somebody else's files and megabytes apiece - neither of which
# belongs in a repository that cannot forget them again.
*.mp3
